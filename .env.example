# Required Spotify application credentials.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Required legacy library settings.
ALBUMS_TO_ADD=10
LIMIT=50

# Optional Spotify applications used in this order after the primary app is
# rate-limited. Configure each id/secret pair together.
APP5_CLIENT_ID=
APP5_CLIENT_SECRET=
APP6_CLIENT_ID=
APP6_CLIENT_SECRET=
APP7_CLIENT_ID=
APP7_CLIENT_SECRET=
APP8_CLIENT_ID=
APP8_CLIENT_SECRET=

# Web password. The local web command must load this file into the process
# environment; the Hugging Face deployment supplies it as a Space secret.
APP_PASSWORD=

# Shared durable state. The default backend reads and writes the private
# Hugging Face dataset below. HF_TOKEN is used when the dedicated token is
# omitted. Set the backend to local only for isolated development or tests.
SPOTIFY_MANAGER_STATE_BACKEND=hub
SPOTIFY_MANAGER_STATE_REPO=cyborg-nomade/spotify-manager-state
SPOTIFY_MANAGER_STATE_FILENAME=state.json
SPOTIFY_MANAGER_STATE_TOKEN=
# SPOTIFY_MANAGER_STATE_LOCAL_PATH=spotify_manager/files/state.json

# Playlist references may be Spotify ids, URIs, or share URLs.
THE_QUEUE_PLAYLIST=
THE_QUEUE_2_PLAYLIST=
THE_QUEUE_3_PLAYLIST=
NEW_KIDS_ON_THE_BLOCK_PLAYLIST=
GREAT_DISCOVERIES_2026_PLAYLIST=
UNLUCKY_ONES_PLAYLIST=
BLAST_FROM_THE_PAST_PLAYLIST=
DAILY_MIND_RADIO_PLAYLIST=
GENRE_REVEAL_PLAYLIST=
FOUND_ART_PLAYLIST=
NEW_WINE_FROM_OLD_BOTTLES_PLAYLIST=
WINE_CELLAR_PLAYLIST=
NEW_VINTAGE_PLAYLIST=
SAUVIGNON_TERRE_NEUVE_PLAYLIST=
SLOW_LISTENING_PLAYLIST=
REQEUEUE_FOR_A_DREAM_PLAYLIST=
PALACE_OF_MEMORY_PLAYLIST=
SOMETHING_OLD_NEW_PLAYLIST=
DISCOGRAPHY_NEWFOUNDLAND_PLAYLIST=
DISCOGRAPHY_MEMORY_LANE_PLAYLIST=
DISCOGRAPHY_REQUEUE_PLAYLIST=

# Read-only Last.fm API access. A Last.fm shared secret is not required.
LASTFM_API_KEY=
LASTFM_USERNAME=
